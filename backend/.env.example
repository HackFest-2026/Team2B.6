# Server Port
PORT=3000

# Database URL
# For local persistent zero-config SQLite:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production deployment (switch provider in schema.prisma to "postgresql"):
# DATABASE_URL="postgresql://username:password@localhost:5432/verimerge?schema=public"

# JWT Secret for Auth sessions
JWT_SECRET="replace_with_a_secure_jwt_secret_in_production"

# Optional Google Gemini API key for evidence-grounded AI assistant
GEMINI_API_KEY=""

# Environment
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
